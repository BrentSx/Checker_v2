# ============================================
# Snickerdoodle Checker - Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ── Server ──────────────────────────────────
# Port for the web interface
PORT=7777
# Secret key for session signing (auto-generated on first run if empty)
SECRET_KEY=

# ── Telegram ────────────────────────────────
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Comma-separated list of Telegram channel IDs to monitor
TELEGRAM_CHANNEL_IDS=

# ── Discord ─────────────────────────────────
# Discord webhook URL for sending results
DISCORD_WEBHOOK_URL=
# Maximum file size for Discord uploads in MB (default: 25)
DISCORD_MAX_FILE_SIZE_MB=25

# ── Cloudflare Tunnel ───────────────────────
# Domain for Cloudflare Tunnel access
CLOUDFLARE_DOMAIN=checker.ravealts.com
# Cloudflare Tunnel token (from Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Checker ─────────────────────────────────
# Path to the checker binary/command
# Leave empty to use the built-in Python checker
CHECKER_COMMAND=
# Number of worker threads for the checker
CHECKER_WORKERS=20
# Directory for proxy list file
PROXY_FILE=

# ── Directories ─────────────────────────────
# Where to store downloaded files
DOWNLOAD_DIR=./downloads
# Temporary directory for extraction
TEMP_DIR=./temp
# Results directory
RESULTS_DIR=./results
# Log directory
LOG_DIR=./logs
# Database directory
DATA_DIR=./data

# ── Queue Settings ──────────────────────────
# Maximum retry attempts for failed jobs
MAX_RETRIES=3
# Delay between retries in seconds
RETRY_DELAY=30

# ── Logging ─────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Maximum log file size in MB
LOG_MAX_SIZE_MB=50
# Number of log files to keep
LOG_BACKUP_COUNT=5
